# Telegram (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Таблица Google (тот же KRO_SHEET_ID, что на Render)
KRO_SHEET_ID=
KRO_CHECK_QUEUE_RANGE=check_queue!A2:B
KRO_SCAM_BASE_RANGE=scam_base!A2:N
KRO_REPORTS_RANGE=A2:F

# Органический рост (медленное наполнение scam_base, цикл 12 ч)
# KRO_ORGANIC_GROWTH=1
# KRO_ORGANIC_MAX_PER_CYCLE=10
# KRO_ORGANIC_KURS_MIN=5
# KRO_ORGANIC_KURS_MAX=10
# KRO_ORGANIC_SEARCH_PAUSE=3
# KRO_ORGANIC_KURS_PARSE_CAP=8000
# KRO_ORGANIC_STATE_PATH=/path/to/kro-organic-state.json
# Массовая заливка kurs в reports (по умолчанию выключена — домены идут через органический цикл)
# KRO_KURS_BULK_WEB_REPORTS=0
# Опционально: отдельный лист для неподтверждённых результатов
# KRO_UNCONFIRMED_RANGE=unconfirmed_results!A2:K

# Доступ к Google (Sheets, Docs). Самый простой способ:
# Скачайте ключ сервисного аккаунта из Google Cloud (JSON) и положите в ЭТУ папку (backend/kro-worker/)
# под именем credentials.json — скрипт подхватит его автоматически, в .env ничего не нужно.
# Вариант 2: путь к файлу ключа
# GOOGLE_APPLICATION_CREDENTIALS=/полный/путь/к/credentials.json
# Вариант 3: JSON в одну строку (часто ломается при source .env)
# KRO_GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Документ Source & Data (ID из ссылки docs.google.com/document/d/ЭТОТ_ID/edit)
# Пример: https://docs.google.com/document/d/1VA3Vrt6sak_TXypqBqQalOWeOJHdQm20gz80s6rfi58/edit
KRO_SOURCES_DOC_ID=1VA3Vrt6sak_TXypqBqQalOWeOJHdQm20gz80s6rfi58

# Лог «События за период»: с какой даты считать отчёт (DD.MM.YYYY). Не задано = сегодня (каждый день «с нуля»).
# KRO_LOG_START_DATE=11.03.2026

# Если в документе 100+ страниц лога и API их не обрезает: добавь в документ ОДНУ строку в самое начало блока лога (перед первой записью с датой), например:
#   ===НАЧАЛО_БЛОКА_СОБЫТИЯ===
# Затем раскомментируй и задай ту же строку здесь — скрипт будет удалять от неё до конца и вставлять короткий блок.
# KRO_LOG_BLOCK_START_MARKER===НАЧАЛО_БЛОКА_СОБЫТИЯ===
# Чтобы не затирать таблицу в конце документа: добавь в документ после блока «События» строку «===КОНЕЦ_БЛОКА_СОБЫТИЙ===», затем свою таблицу. Задай ту же строку здесь.
# KRO_LOG_END_BLOCK_MARKER===КОНЕЦ_БЛОКА_СОБЫТИЙ===

# Стиль блока лога: размер шрифта 8–24 (не задано = как в документе)
# KRO_LOG_FONT_SIZE=11

# Отправка данных на сайт после обновления документа (чтобы ячейки на сайте обновлялись)
KRO_SITE_UPDATE_URL=https://crypto-academy-pro.onrender.com/api/kro/update
# Если на Render задан KRO_UPDATE_SECRET — укажи тот же секрет:
# KRO_SITE_UPDATE_SECRET=твой_секрет
