# Mistral AI API Key (for AI chat responses)
MISTRAL_API_KEY=your_mistral_api_key_here

# CryptoCloud API (for crypto payments)
CRYPTOCLOUD_API_KEY=your_cryptocloud_api_key_here
CRYPTOCLOUD_SHOP_ID=your_cryptocloud_shop_id_here

# CloudPayments API (for card payments)
CLOUDPAYMENTS_PUBLIC_ID=your_cloudpayments_public_id_here
CLOUDPAYMENTS_API_SECRET=your_cloudpayments_api_secret_here

# Subscription settings
SUBSCRIPTION_PRICE_USD=10
SUBSCRIPTION_PERIOD_DAYS=30
FREE_TRIAL_HOURS=24

# News APIs (for dynamic News page - Regulation/Macro/Market + News heat)
NEWS_API_KEY=your_newsapi_key_here
THENEWSAPI_KEY=your_thenewsapi_key_here

# Server settings
PORT=4000
APP_BASE_URL=http://localhost:4000

# Telegram (для KRO live-check воркера: my.telegram.org → API development tools → твоё приложение)
TELEGRAM_API_ID=твой_api_id_число
TELEGRAM_API_HASH=твой_api_hash_строка

# --- Ключи для проверки сделок каналов (реальный плюс/минус по котировкам) ---
# Нужен хотя бы один источник цен (CoinGecko проще, Binance точнее по времени).
# CoinGecko (бесплатный тариф): https://www.coingecko.com/api/documentation
COINGECKO_API_KEY=
# CoinDesk (опционально): developers.coindesk.com → Settings → API keys
COINDESK_API_KEY=
# Binance (только чтение, без торговли): https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

